<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Mounting needs WinFsp, which only exists on Windows. Everywhere else the tool is
         built without it. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <AssemblyName>freexplorer-cli</AssemblyName>
    <RootNamespace>FreeXplorer.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeXplorer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeXplorer.Core\FreeXplorer.Core.csproj" />
    <ProjectReference Include="..\FreeXplorer.WinFsp\FreeXplorer.WinFsp.csproj" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <ProjectReference Include="..\FreeXplorer.Fuse\FreeXplorer.Fuse.csproj" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
