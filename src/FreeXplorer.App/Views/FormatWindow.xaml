<Window x:Class="FreeXplorer.App.Views.FormatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Format" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </Window.Resources>
  <StackPanel Margin="20">
    <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>

    <Border Background="{DynamicResource DangerBackground}" BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1"
            CornerRadius="4" Padding="12,10" Margin="0,12,0,14">
      <TextBlock Text="{Binding Warning}" TextWrapping="Wrap"/>
    </Border>

    <StackPanel Visibility="{Binding ShowModes, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
      <RadioButton x:Name="FullModeButton" GroupName="mode" IsChecked="{Binding FullFormat}" Margin="0,0,0,6">
        <StackPanel>
          <TextBlock Text="Format the drive" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                     Text="Content and the Xbox 1 Compatibility partition, plus the system partitions if the drive doesn't have them. Tick what you want below."/>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="CompatModeButton" GroupName="mode" IsChecked="{Binding CompatOnly}">
        <StackPanel>
          <TextBlock Text="Only the Xbox 1 Compatibility partition" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                     Text="Creates it if the drive hasn't got one, or erases it and makes it again. Nothing else is touched."/>
        </StackPanel>
      </RadioButton>
      <TextBlock Text="{Binding CompatNote}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="22,8,0,0"
                 Visibility="{Binding CompatOnly, Converter={StaticResource BoolToVisibility}}"/>
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Choices}" x:Name="PartitionList"
                  Visibility="{Binding ShowChoices, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
              <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
              </CheckBox>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Margin="0,10,0,0" Visibility="{Binding ShowContentOptions, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Text="Cluster size" VerticalAlignment="Center" Margin="0,0,0,8"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding ClusterChoices}" SelectedItem="{Binding Cluster}" DisplayMemberPath="Text" Margin="0,0,0,8" Padding="6,4"/>

      <CheckBox Grid.Row="1" Content="Limit Content to (GB)" IsChecked="{Binding LimitContent}" VerticalAlignment="Center" Margin="0,0,0,8"
                Visibility="{Binding ShowChoices, Converter={StaticResource BoolToVisibility}}"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ContentGigabytes, UpdateSourceTrigger=PropertyChanged}"
               IsEnabled="{Binding LimitContent}" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left"
               Visibility="{Binding ShowChoices, Converter={StaticResource BoolToVisibility}}"/>

      <TextBlock Grid.Row="2" Text="Volume label" VerticalAlignment="Center"/>
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>
    </Grid>
    <TextBlock Text="{Binding ContentSizeProblem}" Foreground="{DynamicResource ErrorText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding LabelProblem}" Foreground="{DynamicResource ErrorText}" Margin="0,2,0,0"/>

    <Expander x:Name="AdvancedBox" Header="Advanced" Margin="0,10,0,0" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibility}}">
      <CheckBox Margin="0,8,0,0" IsChecked="{Binding CompatOriginalStyle}" Content="Format the Xbox 1 Compatibility partition in the original Xbox (little endian) style"/>
    </Expander>

    <TextBlock Margin="0,16,0,6" TextWrapping="Wrap">
      <Run Text="To continue, type"/>
      <Run Text="{Binding ConfirmationPhrase, Mode=OneWay}" FontWeight="Bold"/>
      <Run Text="below."/>
    </TextBlock>
    <TextBox x:Name="ConfirmBox" Text="{Binding ConfirmText, UpdateSourceTrigger=PropertyChanged}"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Style="{StaticResource PlainButton}" Content="Cancel" IsCancel="True" MinWidth="80"/>
      <Button Style="{StaticResource DangerButton}" Content="Format" IsDefault="True" MinWidth="90" Margin="0"
              IsEnabled="{Binding CanFormat}" Click="OnFormat"/>
    </StackPanel>
  </StackPanel>
</Window>
