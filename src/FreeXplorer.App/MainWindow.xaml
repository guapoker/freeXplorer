<Window x:Class="FreeXplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="freeXplorer" Icon="Assets/app.ico" Width="1180" Height="740" MinWidth="900" MinHeight="580"
        Background="{DynamicResource WindowBackground}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource BarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,10,12,4">
      <StackPanel>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource PlainButton}" Content="Load backup..." Command="{Binding LoadBackupCommand}"
                    ToolTip="Load a backup file, an exact copy of a whole drive, so you can look inside it and mount its partitions like a real drive."/>
            <Button Style="{StaticResource PlainButton}" Content="Create backup..." Command="{Binding CreateBackupCommand}"
                    ToolTip="Save an exact copy of the selected drive, every partition included, in one file."/>
            <Button Style="{StaticResource PlainButton}" Content="Restore backup..." Command="{Binding RestoreBackupCommand}"
                    ToolTip="Write a backup onto a drive, which turns that drive into an exact clone of the one the backup came from. Everything on it is overwritten."/>
            <Button Style="{StaticResource PlainButton}" Content="Refresh" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/>
          </WrapPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <CheckBox x:Name="DarkSwitch" Style="{StaticResource SwitchBox}" Content="Dark mode" Margin="0,0,18,0" VerticalAlignment="Center"
                      AutomationProperties.Name="Dark mode" ToolTip="Switch between the light and the dark look"/>
            <Button x:Name="DriverButton" Command="{Binding InstallDriverCommand}" ToolTip="{Binding DriverDetail}"
                    AutomationProperties.Name="{Binding DriverText}" AutomationProperties.HelpText="{Binding DriverDetail}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DriverButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DriverState}" Value="Missing">
                      <Setter Property="Background" Value="{DynamicResource WarnBackground}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource WarnBorder}"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="DriverLight" Width="9" Height="9" Margin="0,1,8,0" VerticalAlignment="Center">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{DynamicResource StatusWait}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding DriverState}" Value="Installed">
                          <Setter Property="Fill" Value="{DynamicResource StatusGood}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DriverState}" Value="Missing">
                          <Setter Property="Fill" Value="{DynamicResource StatusBad}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding DriverText}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource AccentButton}" Content="Mount" Command="{Binding MountCommand}"
                    ToolTip="Show the selected partition as a drive in This PC."/>
            <Button Style="{StaticResource PlainButton}" Content="Unmount" Command="{Binding UnmountCommand}"/>
            <Button Style="{StaticResource PlainButton}" Content="Open in Explorer" Command="{Binding OpenInExplorerCommand}"/>
            <CheckBox Content="Allow writing when mounting" IsChecked="{Binding AllowWriting}" VerticalAlignment="Center" Margin="12,0,0,0"
                      ToolTip="Off by default: the drive shows up read-only. Turn it on to copy files onto it."/>
          </WrapPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <Button Style="{StaticResource PlainButton}" Content="Check" Command="{Binding CheckCommand}"
                    ToolTip="Look for damage in the selected partition."/>
            <Button Style="{StaticResource PlainButton}" Content="Format..." Command="{Binding FormatCommand}" Margin="0"
                    ToolTip="Format the drive for an Xbox 360, or only its Xbox 1 Compatibility partition."/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Drives" Margin="14,12,14,8"/>
          <ListBox x:Name="SourceList" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SourceItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                  <TextBlock Text="{Binding Note}" Foreground="{DynamicResource NoteText}" FontSize="12" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="14,12,14,8"
                       Text="{Binding SelectedSource.Title, FallbackValue=Partitions}"/>
            <DataGrid x:Name="PartitionGrid" ItemsSource="{Binding Partitions}" SelectedItem="{Binding SelectedPartition, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,0"
                      BorderBrush="{DynamicResource Border}" Background="{DynamicResource CardBackground}" RowHeaderWidth="0" CanUserAddRows="False"
                      CanUserResizeRows="False" MouseDoubleClick="OnPartitionDoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Partition" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80"/>
                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="215"/>
                <DataGridTextColumn Header="Offset" Binding="{Binding OffsetText}" Width="110"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                      <Setter Property="ToolTip" Value="{Binding StatusDetail}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="14" Margin="30"
                     Text="Pick a drive on the left, or load a backup file.">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedSource}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="12,0,12,8" Height="104">
      <ListBox x:Name="LogList" ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent"
               FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextMuted}" ItemContainerStyle="{StaticResource LogItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource BarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="14,6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0">
          <Hyperlink NavigateUri="https://github.com/winfsp/winfsp" RequestNavigate="OnLinkClicked" Foreground="{DynamicResource TextMuted}">WinFsp - Windows File System Proxy, Copyright (C) Bill Zissimopoulos</Hyperlink>
        </TextBlock>
        <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Cancel" Command="{Binding CancelCommand}" Margin="12,0,0,0" Padding="12,2"
                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"/>
        <ProgressBar DockPanel.Dock="Right" Width="180" Height="8" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="12,0,0,0"
                     Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
