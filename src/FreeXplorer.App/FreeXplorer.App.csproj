<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>freeXplorer</AssemblyName>
    <RootNamespace>FreeXplorer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeXplorer.Core\FreeXplorer.Core.csproj" />
    <ProjectReference Include="..\FreeXplorer.WinFsp\FreeXplorer.WinFsp.csproj" />
  </ItemGroup>

</Project>
